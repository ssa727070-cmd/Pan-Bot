# ─── Discord ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values. Never commit .env.
NODE_ENV=production
LOG_LEVEL=info

# Required: bot token from Discord Developer Portal → Bot → Reset Token.
DISCORD_TOKEN=your-bot-token-here
# Required: application ID (not the bot user ID).
DISCORD_CLIENT_ID=your-application-id-here
# Optional: leave empty to register slash commands globally (recommended).
# Set to a guild ID only to speed up development testing.
DISCORD_GUILD_ID=

# ─── Database ────────────────────────────────────────────────────────────────
# Point this at a path inside Wispbyte's persistent storage so warnings,
# tickets, welcome settings and logs survive restarts.
DATABASE_PATH=data/panbot.sqlite

# ─── Appearance ──────────────────────────────────────────────────────────────
# Six-digit hex colour without #, used for embeds.
EMBED_COLOR=5865F2

# ─── Minecraft administration (optional, v1.1.6) ────────────────────────────
# The bot only connects when /mcadmin setup enabled:true is configured in the
# guild. Status queries are read-only and never authenticate. RCON commands are
# disabled until MINECRAFT_RCON_PASSWORD is set, the host permits RCON and the
# Discord guild is listed in MINECRAFT_GUILD_IDS. Host and ports are fixed here:
# Discord users can never change where the bot connects or sends the password.
MINECRAFT_HOST=pansmp.mcserv.world
MINECRAFT_PORT=25565
MINECRAFT_RCON_PORT=25575
# Leave empty if RCON is not enabled by the hosting provider. Never commit a real password.
MINECRAFT_RCON_PASSWORD=
MINECRAFT_RCON_TIMEOUT_MS=5000
MINECRAFT_RCON_RETRIES=1
MINECRAFT_STATUS_TIMEOUT_MS=5000
# Discord guild IDs allowed to use RCON (comma separated). Empty = RCON disabled.
MINECRAFT_GUILD_IDS=
# Consecutive failed status polls before an "offline" notification (1-10).
MINECRAFT_OFFLINE_FAILURES=3

# ─── Bot operators ───────────────────────────────────────────────────────────
# Optional Discord user IDs (comma separated) treated as owners for owner-only
# Minecraft features such as unrestricted console mode.
BOT_OWNER_IDS=
