# ─── Discord ─────────────────────────────────────────────────────────────────
# Never commit this file with real values. Copy it to .env and fill it in.
NODE_ENV=development
LOG_LEVEL=info

DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=123456789012345678
# Optional: register slash commands only in this guild while developing.
DISCORD_GUILD_ID=

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=data/panbot.sqlite

# ─── Lavalink ────────────────────────────────────────────────────────────────
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ─── Behaviour ───────────────────────────────────────────────────────────────
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
EMBED_COLOR=5865F2
