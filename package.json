{
  "name": "pan-bot",
  "version": "0.1.0",
  "private": true,
  "description": "PAN BOT — a professional Discord music bot built with TypeScript, discord.js and Lavalink",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/utils/format.test.ts",
    "healthcheck": "tsx src/scripts/healthcheck.ts",
    "commands:deploy": "tsx src/scripts/deployCommands.ts",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "lavalink",
    "music",
    "typescript",
    "sqlite"
  ],
  "license": "MIT",
  "author": "ssa727070-cmd",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.28.1",
    "dotenv": "^16.6.1",
    "lavalink-client": "^2.11.2",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
